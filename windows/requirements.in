# What the Windows app and its tests need, for windows/requirements.txt (hash-locked). After a change:
#   uv pip compile windows/requirements.in --python-platform windows --python-version 3.12 --generate-hashes -o windows/requirements.txt
# Then: pip install --require-hashes -r windows/requirements.txt
#       pip install --no-deps --no-build-isolation -e ./pipeline -e ./windows
